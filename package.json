{
  "name": "cyphed",
  "version": "0.3.2",
  "private": true,
  "description": "Voice dictation for Windows: talk, and clean text appears where your cursor is.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "node scripts/check.mjs --typecheck",
    "test": "node scripts/check.mjs --test",
    "check": "node scripts/check.mjs",
    "build:native": "node scripts/build-native.mjs",
    "dist": "npm run build:native && electron-vite build && electron-builder --win --config.directories.output=release",
    "release": "node scripts/release.mjs",
    "build:voice": "node scripts/build-voice.mjs",
    "ui:preview": "vite --config scripts/ui-preview/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron-updater": "^6.8.11",
    "koffi": "^2.12.1",
    "lucide-react": "^1.40.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  },
  "author": "bendee1",
  "build": {
    "appId": "app.cyphed.desktop",
    "productName": "Cyphed",
    "copyright": "Cyphed",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/bin/uia-helper.exe",
        "to": "native/uia-helper.exe"
      },
      {
        "from": "native/bin/mouse-helper.exe",
        "to": "native/mouse-helper.exe"
      },
      {
        "from": "native/pocket/pocket-serve.py",
        "to": "native/pocket-serve.py"
      },
      {
        "from": "cyphed-logo-kit/parle/windows/cyphed.ico",
        "to": "brand/cyphed.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "cyphed-logo-kit/parle/windows/cyphed.ico",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cyphed",
      "include": "scripts/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "bendee1",
      "repo": "cyphed",
      "releaseType": "release"
    }
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/bendee1/cyphed.git"
  }
}
